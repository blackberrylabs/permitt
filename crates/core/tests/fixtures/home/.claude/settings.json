{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(npm test)",
      "WebFetch(domain:docs.rs)",
      "Read"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/guard.sh"
          }
        ]
      }
    ]
  }
}
